# 【通用】环境变量 - 所有环境共享（mystabx_vnpy）

# 应用版本号
VITE_VERSION = 3.0.2

# 应用标题
VITE_APP_TITLE = Mystabx Admin

# 开发服务器端口（对齐原 mystabx Vite 默认 5173；原 fastapiadmin 为 6110）
VITE_PORT = 5173

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /web

# 权限模式【 frontend 仅前端路由 / backend 仅后端菜单 / mixed 后端菜单+前端路由模块合并 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否在控制台输出路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

# 网络请求超时时间（毫秒）
VITE_API_TIMEOUT = 120000

# 代理前缀
VITE_APP_BASE_API = /api/v1

# API 基础地址（对齐 mystabx 后端 18080；原 fastapiadmin 为 6100）
VITE_API_BASE_URL = http://127.0.0.1:18080

# 是否删除控制台输出
VITE_DROP_CONSOLE = false

# WebSocket 端点
VITE_APP_WS_ENDPOINT = ws://127.0.0.1:18080
