# ==================================
# 公共默认配置文件（版本控制，安全占位值）
# ==================================
# 优先级：OS 环境变量 > .env.{ENVIRONMENT} > .env（公共） > 代码默认值
#
# 本文件只包含开发者通常需要修改的配置项，其余属性使用代码默认值。
# 敏感信息（密钥、密码、token 等）请在 .env.dev / .env.prod 中覆盖。
# ==================================

ENVIRONMENT = "dev"

# ==================================
# 服务器配置
# ==================================
SERVER_PORT = 6100

# ==================================
# API文档配置
# ==================================
TITLE = "🎉 FastapiAdmin 🎉 -dev"
VERSION = "3.0.0"
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"
ROOT_PATH = "/api/v1"

# ==================================
# 调试模式
# ==================================
DEBUG = True
LOGGER_LEVEL = "DEBUG"  # (DEBUG/INFO/WARNING/ERROR)

# ==================================
# 跨域配置（CORS）
# ==================================
CORS_ORIGIN_ENABLE = True
ALLOW_ORIGINS = ["*"]

# ==================================
# JWT 密钥（生产环境务必更换）
# ==================================
SECRET_KEY = "change-me-to-a-secure-random-key"
TOKEN_TYPE = "bearer"
ACCESS_TOKEN_EXPIRE_SECONDS = 1800        # 秒；1800 秒 = 30 分钟
REFRESH_TOKEN_EXPIRE_SECONDS = 1800       # 秒；1800 秒 = 30 分钟
TOKEN_REQUEST_PATH_EXCLUDE = ["api/v1/auth/login"]

# ==================================
# 数据库连接
# ==================================
DATABASE_TYPE = "mysql"
DATABASE_HOST = "localhost"
DATABASE_PORT = 3306
DATABASE_USER = "root"
DATABASE_PASSWORD = "change-me"
DATABASE_NAME = "fastapiadmin"

# ==================================
# RAG Embedder（知识库向量化）
# ==================================
# 类型: fastembed(默认,本地免key) / openai / openai-like / ollama / sentence-transformer
RAG_EMBEDDER_TYPE = "fastembed"
# 模型（空则按类型使用默认；openai-like 示例: BAAI/bge-large-zh-v1.5）
RAG_EMBEDDER_MODEL = ""
# OpenAI 兼容 Embedder 的 API 地址（也可通过 ai_provider 供应商复用）
RAG_EMBEDDER_BASE_URL = ""
# OpenAI 兼容 Embedder 的 API 密钥
RAG_EMBEDDER_API_KEY = ""
# 指定 ai_provider 表中用于 embedding 的供应商 ID（复用其 base_url/api_key/model）
RAG_EMBEDDER_PROVIDER_ID = null

# ==================================
# Redis
# ==================================
# 本地 Docker Redis 可保持 localhost + 空密码。
# 直连 ECS Redis：HOST=47.102.208.231，PASSWORD=与 .env.ecs 的 REDIS_PWD 相同
# （需安全组放行 TCP 6379；同机服务用 127.0.0.1）。见根目录 .env.ecs.example。
REDIS_ENABLE = True
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_PASSWORD = ""

# ==================================
# 功能开关
# ==================================
CAPTCHA_ENABLE = True
IP_LOCATION_ENABLE = false

