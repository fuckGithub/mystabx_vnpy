# ==================================
# 公共默认配置（mystabx_vnpy · 版本控制，安全占位）
# ==================================
# 优先级：OS 环境变量 > .env.{ENVIRONMENT} > .env（公共） > 代码默认值
#
# MySQL / Redis / 端口对齐本仓库 vnpy 产品与 .env.ecs（非上游 fastapiadmin 默认值）。
# 真实密码只写本机 .env / .env.ecs，勿提交。
# ==================================

ENVIRONMENT = "dev"

# ==================================
# 服务器配置（ECS / 生产默认 STABX_PORT=18080）
# ==================================
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 18080

# ==================================
# API文档配置
# ==================================
TITLE = "Mystabx Admin"
VERSION = "3.0.0"
DESCRIPTION = "mystabx_vnpy 管理平台（FastapiAdmin 能力迁入）。"
ROOT_PATH = "/api/v1"

# ==================================
# 调试模式
# ==================================
DEBUG = True
LOGGER_LEVEL = "DEBUG"  # (DEBUG/INFO/WARNING/ERROR)

# ==================================
# 跨域配置（CORS）
# ==================================
CORS_ORIGIN_ENABLE = True
ALLOW_ORIGINS = ["*"]

# ==================================
# JWT 密钥（生产环境务必更换）
# ==================================
SECRET_KEY = "change-me-to-a-secure-random-key"
TOKEN_TYPE = "bearer"
ACCESS_TOKEN_EXPIRE_SECONDS = 1800        # 秒；1800 秒 = 30 分钟
REFRESH_TOKEN_EXPIRE_SECONDS = 1800       # 秒；1800 秒 = 30 分钟
TOKEN_REQUEST_PATH_EXCLUDE = ["api/v1/auth/login"]

# ==================================
# 数据库连接（阿里云 RDS · 库名 mystabx_vnpy）
# 本机开发用外网主机；ECS 同机用内网主机（见 .env.prod.example）
# ==================================
DATABASE_TYPE = "mysql"
DATABASE_HOST = "rm-uf608r538nh6i50f3to.mysql.rds.aliyuncs.com"
DATABASE_PORT = 3306
DATABASE_USER = "root"
DATABASE_PASSWORD = "your-mysql-password"
DATABASE_NAME = "mystabx_vnpy"

# ==================================
# RAG Embedder（知识库向量化）
# ==================================
RAG_EMBEDDER_TYPE = "fastembed"
RAG_EMBEDDER_MODEL = ""
RAG_EMBEDDER_BASE_URL = ""
RAG_EMBEDDER_API_KEY = ""
RAG_EMBEDDER_PROVIDER_ID = null

# ==================================
# Redis（跑在 ECS 47.102.208.231；密码 = .env.ecs 的 REDIS_PWD）
# 本机开发：公网 HOST（需安全组放行 TCP 6379）
# 同机部署：改 REDIS_HOST = "127.0.0.1"
# ==================================
REDIS_ENABLE = True
REDIS_HOST = "47.102.208.231"
REDIS_PORT = 6379
REDIS_PASSWORD = "your-redis-requirepass"

# ==================================
# 功能开关
# ==================================
CAPTCHA_ENABLE = False
IP_LOCATION_ENABLE = false

# ==================================
# 阿里云 OSS（文件管理 / 存储节点）
# 与 mystabx UPMS 对齐：OSS_ACCESS_KEY / OSS_SECRET_KEY
# OSS_ENABLE=true 且 AccessKey/Secret/Bucket 齐全时，「文件管理」走对象存储
# ==================================
OSS_ENABLE = false
OSS_ACCESS_KEY = ""
OSS_SECRET_KEY = ""
OSS_ENDPOINT = "https://oss-cn-beijing.aliyuncs.com"
OSS_BUCKET_NAME = ""
OSS_REGION = "cn-beijing"
OSS_CUSTOM_DOMAIN = ""
OSS_PREFIX = "upload/"
OSS_SIGN_URL_EXPIRE_SECONDS = 3600

# ================================================= #
# ******************** 国密加密配置 ***************** #
# ================================================= #
SM2_PRIVATE_KEY=0783e21566c9cb0a1dc3468f5855412f7101462d7df9987c07b19166f1b74b31
SM2_PUBLIC_KEY=04427f6baf23b6cb98373c94de48abbef82725f2968e97c4e9253f04e9416a931e4035500c14e5f09ddfc3acdfe22a88d6e10697ff9fafb7ab8de17a1b076ccf1a
SM4_KEY=d5834d482f7c67cdf21a61337dad7fff
