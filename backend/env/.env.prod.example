# ==================================
# 生产环境配置模板
# 复制此文件为 .env.prod 并填入真实值
# ==================================
# 优先级：OS 环境变量 > .env.prod > .env（公共） > 代码默认值
#
# 本文件只包含开发者通常需要修改的配置项，其余属性使用代码默认值。
# ==================================

ENVIRONMENT = "prod"

# ==================================
# 服务器配置
# ==================================
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 6100

# ==================================
# API文档配置
# ==================================
TITLE = "🎉 FastapiAdmin 🎉 -prod"
VERSION = "3.0.0"
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"
ROOT_PATH = "/api/v1"

# ==================================
# 调试模式
# ==================================
DEBUG = False
LOGGER_LEVEL = "INFO"  # (DEBUG/INFO/WARNING/ERROR)

# ==================================
# 跨域配置（CORS）
# ==================================
CORS_ORIGIN_ENABLE = True
ALLOW_ORIGINS = ["*"]

# ==================================
# JWT 密钥（生产环境务必更换）
# ==================================
SECRET_KEY = "your-prod-secret-key-change-me"
TOKEN_TYPE = "bearer"
ACCESS_TOKEN_EXPIRE_SECONDS = 1800        # 秒；1800 秒 = 30 分钟
REFRESH_TOKEN_EXPIRE_SECONDS = 1800       # 秒；1800 秒 = 30 分钟

# ==================================
# 数据库连接
# ==================================
DATABASE_TYPE = "mysql"
DATABASE_HOST = "your_database_host"
DATABASE_PORT = 3306
DATABASE_USER = "root"
DATABASE_PASSWORD = "your_database_password"
DATABASE_NAME = "fastapiadmin"

# ==================================
# Redis
# ==================================
# ECS（47.102.208.231）已安装 redis-server：
#   - 同机部署：REDIS_HOST = "127.0.0.1"
#   - 本机连 ECS：REDIS_HOST = "47.102.208.231"（需安全组放行 TCP 6379）
# 密码与运维 .env.ecs 的 REDIS_PWD 一致（requirepass），勿把真实密码提交入库。
REDIS_ENABLE = True
REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_PASSWORD = "your_redis_password"
