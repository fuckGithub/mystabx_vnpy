{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["ui/*"]
    }
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.vue",
    "ui/**/*.d.ts",
    "features/**/*.vue",
    "features/**/*.ts",
    "vite.config.ts"
  ]
}
