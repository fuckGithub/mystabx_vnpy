# ==================================
# 生产 / ECS 配置模板（mystabx_vnpy）
# 复制为 .env.prod 并填入真实值；勿提交真实密码
# ==================================
# 优先级：OS 环境变量 > .env.prod > .env（公共） > 代码默认值
# ==================================

ENVIRONMENT = "prod"

# ==================================
# 服务器配置（对齐 STABX_PORT / nginx → 18080）
# ==================================
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 18080

# ==================================
# API文档配置
# ==================================
TITLE = "Mystabx Admin"
VERSION = "3.0.0"
DESCRIPTION = "mystabx_vnpy 管理平台（生产）。"
ROOT_PATH = "/api/v1"

# ==================================
# 调试模式
# ==================================
DEBUG = False
LOGGER_LEVEL = "INFO"  # (DEBUG/INFO/WARNING/ERROR)

# ==================================
# 跨域配置（CORS）
# ==================================
CORS_ORIGIN_ENABLE = True
ALLOW_ORIGINS = ["*"]

# ==================================
# JWT 密钥（生产环境务必更换）
# ==================================
SECRET_KEY = "your-prod-secret-key-change-me"
TOKEN_TYPE = "bearer"
ACCESS_TOKEN_EXPIRE_SECONDS = 1800
REFRESH_TOKEN_EXPIRE_SECONDS = 1800

# ==================================
# 数据库（ECS 上优先 RDS 内网）
# ==================================
DATABASE_TYPE = "mysql"
DATABASE_HOST = "rm-uf608r538nh6i50f3.mysql.rds.aliyuncs.com"
DATABASE_PORT = 3306
DATABASE_USER = "root"
DATABASE_PASSWORD = "your-mysql-password"
DATABASE_NAME = "mystabx_vnpy"

# ==================================
# Redis（ECS 本机 redis-server）
# 同机：127.0.0.1；密码与 .env.ecs 的 REDIS_PWD / requirepass 一致
# ==================================
REDIS_ENABLE = True
REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_PASSWORD = "your-redis-requirepass"

# ==================================
# 功能开关
# ==================================
CAPTCHA_ENABLE = False

# ==================================
# 阿里云 OSS（文件管理 / 存储节点）
# 生产填写真实 AccessKey；勿提交 .env.prod
# ==================================
OSS_ENABLE = true
OSS_ACCESS_KEY = ""
OSS_SECRET_KEY = ""
OSS_ENDPOINT = "https://oss-cn-beijing.aliyuncs.com"
OSS_BUCKET_NAME = "stabx-dev"
OSS_REGION = "cn-beijing"
OSS_CUSTOM_DOMAIN = "https://stabx-dev.oss-cn-beijing.aliyuncs.com"
OSS_PUBLIC_READ = false
OSS_PREFIX = "upload/"
OSS_SIGN_URL_EXPIRE_SECONDS = 3600

# ================================================= #
# ******************** 国密加密配置 ***************** #
# ================================================= #
# 登录密码 SM2 传输加密（须与前端 sm-crypto 配对；缺失会导致登录「账号或密码错误」）
SM2_PRIVATE_KEY=0783e21566c9cb0a1dc3468f5855412f7101462d7df9987c07b19166f1b74b31
SM2_PUBLIC_KEY=04427f6baf23b6cb98373c94de48abbef82725f2968e97c4e9253f04e9416a931e4035500c14e5f09ddfc3acdfe22a88d6e10697ff9fafb7ab8de17a1b076ccf1a
SM4_KEY=d5834d482f7c67cdf21a61337dad7fff
