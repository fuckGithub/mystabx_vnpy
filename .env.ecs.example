# 复制为 .env.ecs 后填写（.env.ecs 已 gitignore，勿提交）
# 完整说明见 docs/ecs-rds.example.md / docs/ecs-rds.local.md
# 部署脚本 scripts/deploy_ecs.sh 用安全解析读取下列键（勿 source：密码可含 # &）

ECS_HOST=47.102.208.231
ECS_USER=root
ECS_PASSWORD=
# 可选：远端仓库路径（默认 /stabx/mystabx_vnpy）
# ECS_REMOTE_DIR=/stabx/mystabx_vnpy
# 可选：应用端口（默认 18080）
# STABX_PORT=18080

# RDS MySQL（mystabx_vnpy 业务库；应用也读 STABX_MYSQL_*）
# 密码含 & # 空格时请加引号，例如：MYSQL_PWD='your#pass&word'
# （远端 ./start.sh 已安全解析；deploy_ecs.sh 亦不 source 本文件）
MYSQL_HOST=rm-uf608r538nh6i50f3to.mysql.rds.aliyuncs.com
MYSQL_USER=root
MYSQL_PWD=
MYSQL_PORT=3306
MYSQL_DB=mystabx_vnpy
# 可选显式覆盖：
# STABX_MYSQL_HOST=
# STABX_MYSQL_PORT=3306
# STABX_MYSQL_USER=root
# STABX_MYSQL_PASSWORD=
# STABX_MYSQL_DATABASE=mystabx_vnpy

REDIS_HOST=47.102.208.231
REDIS_PORT=6379
REDIS_PWD=

RABBIT_HOST=47.102.208.231
RABBIT_PORT=5672
RABBIT_USER=stabx
RABBIT_PWD=
RABBIT_VHOST=/

NACOS_HOST=47.102.208.231
