# 本机运维模板（复制为 .env.ecs，勿提交真实密码）
# 对应 ECS：阿里云 47.102.208.231（内网 172.16.48.255）
# Redis 已装在 ECS（apt redis-server），同机应用用 127.0.0.1；本机开发用公网 IP（需安全组放行 TCP 6379）

ECS_HOST=47.102.208.231
ECS_USER=root
ECS_PASSWORD=your-ecs-ssh-password

MYSQL_HOST=your-rds-public-host.mysql.rds.aliyuncs.com
MYSQL_USER=root
MYSQL_PWD=your-mysql-password
MYSQL_PORT=3306
MYSQL_DB=mystabx_vnpy

# 运维侧常用 REDIS_PWD；FastapiAdmin 后端请映射为 REDIS_PASSWORD
REDIS_HOST=47.102.208.231
REDIS_PORT=6379
REDIS_PWD=your-redis-requirepass

RABBIT_HOST=47.102.208.231
RABBIT_PORT=5672
RABBIT_USER=stabx
RABBIT_PWD=your-rabbit-password
RABBIT_VHOST=/

NACOS_HOST=47.102.208.231
