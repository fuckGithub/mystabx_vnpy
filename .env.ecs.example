# 本机运维模板（复制为 .env.ecs，勿提交真实密码）
# 对齐 vnpy 分支 / docs/ecs-rds.example.md · ECS 47.102.208.231

ECS_HOST=47.102.208.231
ECS_USER=root
ECS_PASSWORD=your-ecs-ssh-password
# ECS_REMOTE_DIR=/stabx/mystabx_vnpy
# STABX_PORT=18080

# RDS MySQL（外网；ECS 应用可用内网 rm-uf608r538nh6i50f3.mysql.rds.aliyuncs.com）
MYSQL_HOST=rm-uf608r538nh6i50f3to.mysql.rds.aliyuncs.com
MYSQL_USER=root
MYSQL_PWD=your-mysql-password
MYSQL_PORT=3306
MYSQL_DB=mystabx_vnpy

# FastapiAdmin 后端键名映射（与 MYSQL_* / REDIS_* 对应，供 backend/env 使用）
# DATABASE_HOST / DATABASE_PORT / DATABASE_USER / DATABASE_PASSWORD / DATABASE_NAME
# REDIS_PASSWORD = REDIS_PWD

# Redis（ECS apt redis-server；同机 127.0.0.1，本机开发用公网）
REDIS_HOST=47.102.208.231
REDIS_PORT=6379
REDIS_PWD=your-redis-requirepass

# 阿里云 OSS（可选；真实密钥只写本机 .env.ecs / 远端 backend/env/.env.prod，勿提交）
# OSS_ENABLE=true
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_BUCKET_NAME=stabx-dev
# OSS_REGION=cn-beijing
# OSS_CUSTOM_DOMAIN=https://stabx-dev.oss-cn-beijing.aliyuncs.com
# OSS_PREFIX=upload/

RABBIT_HOST=47.102.208.231
RABBIT_PORT=5672
RABBIT_USER=stabx
RABBIT_PWD=your-rabbit-password
RABBIT_VHOST=/

NACOS_HOST=47.102.208.231
