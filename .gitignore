# ============================
# macOS / 编辑器临时文件
# ============================
**/.DS_Store
*.swp
*.swo
*~
.AppleDouble
.LSOverride
._*

# ============================
# IDE（本机路径不入库）
# ============================
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
cmake-build-*/
out/
# fastapiadmin 自带共享 launch/settings，允许入库；本机覆盖仍忽略
# .vscode/
*.code-workspace
.cursor/

# ============================
# 环境变量 / 密钥（永不提交）
# ============================
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
.envrc
docs/ecs-rds.local.md
docs/ecs&rds.md

# ============================
# Python
# ============================
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
.venv/
venv/
# 仅忽略仓库根目录名为 ENV 的虚拟环境；勿写成 ENV/（macOS 忽略大小写会误伤 admin/env/）
/ENV/
env.bak/
venv.bak/
# 后端环境模板必须入库（覆盖上方 **/.env 规则对 example 的放行已足够，此处显式保证目录不被 ENV 误伤）
!admin/env/
!admin/env/.env.example
!admin/env/.env.prod.example
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
cover/
*.cover
*.py.cover
*.lcov
.hypothesis/
cython_debug/

