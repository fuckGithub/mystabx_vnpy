{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "uv run start",
      "type": "debugpy",
      "request": "launch",
      "module": "core.start",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "uv run start --dev",
      "type": "debugpy",
      "request": "launch",
      "module": "core.start",
      "args": ["--dev"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    }
  ]
}
