{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Run Dev",
      "type": "debugpy",
      "request": "launch",
      "module": "main",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "args": ["run", "--env=dev"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backend: Run Prod",
      "type": "debugpy",
      "request": "launch",
      "module": "main",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "args": ["run", "--env=prod"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
