# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android release signing (secrets — never commit)
android/key.properties
android/app/*.jks
android/app/*.keystore

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

