# 【开发】环境变量 - 覆盖通用配置（mystabx_vnpy）

# 环境标识
VITE_APP_ENV = development

# 项目名称
VITE_APP_TITLE = Mystabx Admin

# 浏览器侧同源前缀（与 Vite 代理配合时用 /，请求走 localhost:端口 + 代理）
VITE_API_URL = /

# 代理目标：本机后端（18080）
VITE_API_BASE_URL = http://127.0.0.1:18080

# 是否删除控制台输出
VITE_DROP_CONSOLE = false

# WebSocket 端点
VITE_APP_WS_ENDPOINT = ws://127.0.0.1:18080
