# 复制为 .env 后按需修改。不要提交 .env，也不要把真实 SimNow 密码写入仓库。

# 监听地址 / 端口（./start.sh 默认生产模式绑定这些值）
STABX_HOST=0.0.0.0
STABX_PORT=18080

# 首次引导管理员（仅当 SQLite 里还没有该用户时写入）
# 生产 / ECS：务必设强随机密码，勿用 admin123
STABX_ADMIN_USERNAME=admin
STABX_ADMIN_PASSWORD=

# JWT / 账户密钥加密。留空则自动生成并写入本机 .vntrader/web_keys.json
# STABX_JWT_SECRET=
# STABX_FERNET_KEY=

# 可选
# STABX_ACCESS_MINUTES=60
# STABX_REFRESH_DAYS=7
# STABX_SQLITE_PATH=
# STABX_CLICKHOUSE_URL=http://127.0.0.1:8123
# STABX_CLICKHOUSE_HOST=127.0.0.1
# STABX_CLICKHOUSE_PORT=8123
# STABX_CLICKHOUSE_USER=default
# STABX_CLICKHOUSE_PASSWORD=
# STABX_CLICKHOUSE_DATABASE=vnpy
# STABX_CLICKHOUSE_TICK_TTL_DAYS=10
# STABX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# STABX_SKIP_BUILD=0

# P8 性能埋点告警阈值（/health → metrics.alerts）
# STABX_METRIC_T2T_P99_MS=50
# STABX_METRIC_CH_QUEUE_WARN=40000
# STABX_METRIC_WS_PENDING_WARN=2000

# 本机「新建通道」预填资金账号 / 密码（仅管理员 GET /api/admin/connect-defaults 回填表单）。
# 不要把真实值写进本文件或任何入库文件；只写在已 gitignore 的 .env。
# STABX_SIMNOW_USER=
# STABX_SIMNOW_PASSWORD=
