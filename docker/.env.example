# ============================================
# Docker Compose 变量文件（只放 compose 插值用的变量）
# 用法：cp .env.example .env 后填写真实密码
#
# 应用自身的配置不在这里：
#   方式 A（全套）  → backend/env/.env.prod
#   方式 B（仅后端）→ 与编排文件同级的 env.prod
# 详见 docker/README.md
# ============================================

# ---- 后端 ----
BACKEND_PORT=6100        # 宿主机映射端口（容器内固定 6100）
IMAGE_TAG=3.1.0          # 后端镜像 tag

# ---- Nginx（仅方式 A 使用）----
HTTP_PORT=80
HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fastapiadmin
MYSQL_USER=fastapiadmin
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
