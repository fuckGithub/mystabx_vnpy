# ============================================
# Docker Compose 变量文件（mystabx_vnpy）
# 用法：cp .env.example .env 后填写真实密码
#
# 应用自身的配置不在这里：
#   方式 A（全套）  → backend/env/.env.prod
#   方式 B（仅后端）→ 与编排文件同级的 env.prod
# 详见 docker/README.md
# ============================================

# ---- 后端（对齐 mystabx STABX_PORT=18080）----
BACKEND_PORT=18080       # 宿主机映射端口（容器内同为 18080）
IMAGE_TAG=3.1.0          # 后端镜像 tag

# ---- Nginx（仅方式 A 使用）----
HTTP_PORT=80
HTTPS_PORT=443

# ---- MySQL（库名 / 用户对齐 mystabx_vnpy；方式 A 本地容器时用）----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mystabx_vnpy
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---- Redis ----
# 方式 A：compose 内 redis 容器；密码必填。
# 方式 B 同机已有 ECS redis-server：在 backend env.prod 设 REDIS_HOST=127.0.0.1
# 与 REDIS_PASSWORD（= 运维 .env.ecs 的 REDIS_PWD）。
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
